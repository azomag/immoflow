APP_NAME=ImmoFlow
APP_ENV=production
APP_DEBUG=false
APP_URL=https://surprising-joy-production.up.railway.app
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_URL=mysql://avnadmin:YOUR_PASSWORD@immoflow-immoflow.g.aivencloud.com:14271/defaultdb?ssl-mode=REQUIRED
# Optional explicit parts (not required if DB_URL is set):
# DB_HOST=immoflow-immoflow.g.aivencloud.com
# DB_PORT=14271
# DB_DATABASE=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=YOUR_PASSWORD

# Paste Aiven CA certificate content exactly (multiline) in Render env var:
DB_SSL_CA_CONTENT=
# Or provide base64-encoded certificate instead:
# DB_SSL_CA_BASE64=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

# Replace with your Vercel frontend URL(s), comma-separated.
CORS_ALLOWED_ORIGINS=https://immoflow-gray.vercel.app,https://immoflow-maroc.vercel.app
